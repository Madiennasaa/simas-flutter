<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Izinkan HTTP polos (cleartext) buat akses backend lokal via
         http://localhost saat develop (adb reverse tcp:3000 tcp:3000).
         Android 9+ blokir ini secara default kalau tidak diizinkan begini.
         Cuma berlaku di build debug, tidak kebawa ke staging/production. -->
    <application android:usesCleartextTraffic="true" />
</manifest>
